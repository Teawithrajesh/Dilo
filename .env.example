# DILO environment variables. Copy to .env.local for local work. Never commit .env files (they are git-ignored).
#
# Everything prefixed NEXT_PUBLIC_ is built INTO THE BROWSER CODE and anyone can read it.
# Only public-safe values may use that prefix.
#
# Supabase (live site feedback + early access). Use the PUBLISHABLE key (sb_publishable_...) only.
# It is safe in the browser ONLY because Row Level Security is on for every table and visitors may
# only INSERT (see supabase/migrations). If empty, the build uses config/public-supabase.json.
# NEVER put the secret / service_role key here or anywhere in this repo: the build refuses it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Public address of the site, for link previews.
NEXT_PUBLIC_SITE_URL=https://dilowish.com

# Contact email shown on the privacy page (public). Defaults to hello@dilowish.com.
NEXT_PUBLIC_CONTACT_EMAIL=hello@dilowish.com

# Server-side secrets: NONE today. DILO is a static site with no server code, so there is nowhere
# safe to use a secret key (Stripe secret, service_role, OAuth client secret, JWT secret, SMTP,
# OpenAI, etc.). If one is ever needed, it goes in Cloudflare/Supabase secret settings, never here
# with a NEXT_PUBLIC_ prefix and never in git.
