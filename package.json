{
  "name": "dilo",
  "version": "0.1.0",
  "private": true,
  "description": "DILO \u2014 Together, We Make Dreams Come True. Phase 1 prototype (demo data only).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview:update": "next build && node -e \"const fs=require('fs');fs.rmSync('preview',{recursive:true,force:true});fs.cpSync('out','preview',{recursive:true})\"",
    "serve": "node scripts/serve.mjs preview",
    "lint:types": "tsc --noEmit",
    "test:contrast": "node scripts/check-contrast.mjs",
    "brand:build": "echo \"See scripts/brand/build_logos.py (needs Python fonttools)\"",
    "test": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.0"
  }
}
